# Local demo works with no API keys. It never fetches the example URLs.
DATABASE_URL=sqlite+aiosqlite:///./data/signaldesk.db
CHECKPOINT_URL=sqlite:///./data/checkpoints.db
MEMORY_URL=sqlite:///./data/memory.db
MEMORY_MAX_ITEMS=50
RESEARCH_MODE=demo
API_TOKEN=

# Live mode uses an OpenAI-compatible model; enter an actual model available to your account.
MODEL=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-provider.example/v1

# Optional long-term vector retrieval. Requires PostgreSQL with pgvector and an embedding model.
ENABLE_VECTOR_SEARCH=false
ENABLE_FULLTEXT_SEARCH=true
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# Default is an explicit lexical baseline. Set http for neural/model reranking.
RERANKER_PROVIDER=lexical
RERANKER_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_TIMEOUT_SECONDS=20
RETRIEVAL_CANDIDATES=30

# Optional remote MCP servers. Explicitly trusted tool endpoints only; [] disables them.
MCP_URLS=[]
MCP_ALLOWED_TOOLS=[]

# Disposable local Docker containers. Start Docker and pre-pull the fixed image before enabling.
SANDBOX_ENABLED=false
SANDBOX_IMAGE=python:3.14-slim
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_MB=128
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=32
SANDBOX_MAX_CONCURRENT=2
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_MAX_CODE_BYTES=20000
SANDBOX_MAX_INPUT_BYTES=65536

# A2A 1.0 JSON-RPC server and administrator-named remote Agents; no arbitrary URL input.
ENABLE_A2A=false
A2A_PUBLIC_URL=http://127.0.0.1:8000/a2a/
A2A_REMOTE_AGENTS={}
A2A_REMOTE_TOKENS={}
A2A_REMOTE_PROJECTS={}
A2A_TIMEOUT_SECONDS=180

MAX_CONCURRENT_RUNS=2
AGENT_TIMEOUT_SECONDS=180
AGENT_RECURSION_LIMIT=24

# Optional LangSmith tracing (configure before startup).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=signaldesk
